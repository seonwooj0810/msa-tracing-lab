{
  "uid": "msa-flow",
  "title": "MSA 요청 흐름",
  "tags": [
    "msa-tracing-lab"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "nodeGraph",
      "title": "서비스 맵 (호출 흐름)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "serviceMap"
        }
      ]
    },
    {
      "id": 2,
      "type": "table",
      "title": "최초 실패 지점 — 가장 깊은 에러 span (클릭하면 trace)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "tableType": "spans",
          "limit": 20,
          "query": "{ status = error } !<< { status = error } | select(resource.service.name, span.uri, span.status)"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "traceService": true,
              "name": true,
              "traceName": true
            },
            "indexByName": {
              "service.name": 0,
              "uri": 1,
              "status": 2,
              "spanID": 3,
              "time": 4,
              "duration": 5
            },
            "renameByName": {
              "service.name": "원인 서비스",
              "uri": "호출 대상",
              "status": "상태",
              "duration": "소요",
              "time": "시각",
              "spanID": "Span ID",
              "traceName": "요청(루트)"
            }
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "서비스별 요청률 (req/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{job}}",
          "expr": "sum by (job) (rate(http_server_requests_seconds_count[1m]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "서비스별 5xx (req/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{job}}",
          "expr": "sum by (job) (rate(http_server_requests_seconds_count{outcome=\"SERVER_ERROR\"}[1m]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "서비스별 p95 지연 (s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{service}}",
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(traces_spanmetrics_latency_bucket{span_kind=\"SPAN_KIND_SERVER\"}[1m])))"
        }
      ]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "최근 WARN·ERROR 로그 (traceId 링크 → Tempo)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service=~\".+\"} |~ \" (WARN|ERROR) \" !~ \"SpringDocAppInitializer\""
        }
      ]
    }
  ]
}